{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ARAPUCA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development (GCC, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (GCC, RelWithDebInfo)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "inherits": "base",
      "displayName": "Clang (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "asan",
      "inherits": "clang",
      "displayName": "AddressSanitizer and UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "ARAPUCA_ENABLE_ASAN": "ON",
        "ARAPUCA_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "clang",
      "displayName": "ThreadSanitizer",
      "cacheVariables": { "ARAPUCA_ENABLE_TSAN": "ON" }
    },
    {
      "name": "fuzz",
      "inherits": "clang",
      "displayName": "libFuzzer targets",
      "cacheVariables": {
        "ARAPUCA_BUILD_FUZZERS": "ON",
        "ARAPUCA_ENABLE_ASAN": "ON",
        "ARAPUCA_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tidy",
      "inherits": "clang",
      "displayName": "clang-tidy run",
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--warnings-as-errors=*"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "clang", "configurePreset": "clang" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "tidy", "configurePreset": "tidy" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
