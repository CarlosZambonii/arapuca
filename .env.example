# Arapuca environment template.
# Copy to .env and fill in. The .env file is git ignored and must never be committed.

# --- Honeypot identity ---------------------------------------------------
# Shown in every event as "sensor". Use a name, not the real hostname.
ARAPUCA_SENSOR_NAME=arapuca-sa-saopaulo-1

# --- VirusTotal (optional) -----------------------------------------------
# Free tier key. Only hash lookups are performed, samples are never uploaded.
# Leave empty to disable VirusTotal enrichment entirely.
VT_API_KEY=

# --- New Relic ------------------------------------------------------------
# Ingest license key used by the Infrastructure Agent on the VPS.
NEW_RELIC_LICENSE_KEY=
# User API key used by Terraform and by the scheduled IoC export.
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
# US or EU, must match the account region.
NEW_RELIC_REGION=US

# --- MaxMind GeoLite2 -----------------------------------------------------
# Used at deploy time to download the GeoLite2 City and ASN databases.
# The .mmdb files are never committed.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Oracle Cloud ---------------------------------------------------------
# Read by Terraform. The OCI CLI reads ~/.oci/config instead.
TF_VAR_compartment_ocid=
# CIDR allowed to reach the real SSH port. Never 0.0.0.0/0.
TF_VAR_operator_cidr=
